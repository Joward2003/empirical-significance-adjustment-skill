{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rejected or Failed Attempt Audit Event",
  "description": "Records an observed but unapproved specification without treating it as evidence for the main analysis.",
  "type": "object",
  "required": [
    "event_id",
    "project_id",
    "project_sha256",
    "method_id",
    "adjustment_level",
    "analysis_stage",
    "event_type",
    "diagnostic_evidence",
    "reason",
    "proposed_specification",
    "timestamp"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "method_id": {"type": "string", "minLength": 1},
    "adjustment_level": {"enum": ["A", "B", "C", "D"]},
    "analysis_stage": {"enum": ["pre_registered", "pre_specified", "exploratory", "unknown"]},
    "event_type": {"enum": ["rejected_specification", "failed_attempt"]},
    "diagnostic_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reason": {"type": "string", "minLength": 1},
    "proposed_specification": {"type": "object", "minProperties": 1},
    "observed_result": {"type": ["object", "null"]},
    "decision_used_p_value": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
